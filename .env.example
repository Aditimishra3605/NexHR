# NexHR Environment Configuration
# Copy this file to .env and fill in your values.

# Database: defaults to a local SQLite file if left unset (great for demo/viva).
# For a real deployment, point this at PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/nexhr
DATABASE_URL=sqlite:///nexhr.db

# Groq API key (free tier available at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default Groq model
GROQ_MODEL=llama-3.3-70b-versatile
